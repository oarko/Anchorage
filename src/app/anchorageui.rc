<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE gui SYSTEM "kpartgui.dtd">
<gui name="anchorage" version="4">
  <MenuBar>
    <Menu name="file">
      <text>&amp;File</text>
      <Action name="entry_new"/>
      <Action name="connect_server"/>
      <Separator/>
      <Action name="changes_apply"/>
      <Action name="changes_preview"/>
      <Action name="changes_discard"/>
    </Menu>
    <Menu name="edit">
      <text>&amp;Edit</text>
      <Action name="entry_edit"/>
      <Action name="entry_remove"/>
      <Separator/>
      <Action name="allow_system_editing"/>
    </Menu>
    <Menu name="view">
      <text>&amp;View</text>
      <Action name="view_redisplay"/>
    </Menu>
  </MenuBar>
  <ToolBar name="mainToolBar">
    <text>Main Toolbar</text>
    <Action name="entry_new"/>
    <Action name="connect_server"/>
    <Action name="entry_edit"/>
    <Action name="entry_remove"/>
    <Separator/>
    <Action name="allow_system_editing"/>
    <Separator/>
    <Action name="view_redisplay"/>
  </ToolBar>
</gui>
