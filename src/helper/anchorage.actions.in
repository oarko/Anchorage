[Domain]
Name=@APP_NAME@
Icon=drive-harddisk

[@APP_ID@.writefstab]
Name=Change /etc/fstab
Description=Changing which drives and shares are mounted at startup requires authentication
Policy=auth_admin
Persistence=session

[@APP_ID@.restorebackup]
Name=Restore /etc/fstab from a backup
Description=Restoring a saved copy of /etc/fstab requires authentication
Policy=auth_admin
Persistence=session

[@APP_ID@.addsharedmount]
Name=Add a shared network mount
Description=Adding a network share that all users can see requires authentication
Policy=auth_admin
Persistence=session

[@APP_ID@.removesharedmount]
Name=Remove a shared network mount
Description=Removing a shared network mount requires authentication
Policy=auth_admin
Persistence=session

[@APP_ID@.writesettings]
Name=Change Anchorage's settings
Description=Changing Anchorage's system-wide settings requires authentication
Policy=auth_admin
Persistence=session

[@APP_ID@.mountentry]
Name=Mount a drive or share from /etc/fstab
Description=Mounting a drive or network share requires authentication
Policy=auth_admin
Persistence=session

[@APP_ID@.mounttemporary]
Name=Mount a drive or share at a chosen folder
Description=Mounting a drive or network share at a chosen folder requires authentication
Policy=auth_admin
Persistence=session

[@APP_ID@.unmount]
Name=Unmount a drive or share
Description=Unmounting a drive or network share requires authentication
Policy=auth_admin
Persistence=session
