# Network shares
nas.local:/export/media  /mnt/media    nfs4  vers=4.2,_netdev,nofail,noauto,x-systemd.automount  0  0
//nas.local/Backups      /srv/backups  cifs  credentials=/etc/anchorage/credentials/nas-backups,uid=1000,gid=1000,vers=3.1.1,seal,_netdev,nofail  0  0
//nas.local/My\040Games  /mnt/games    cifs  guest,vers=3.1.1,nosuid,nodev,_netdev,nofail,x-systemd.idle-timeout=10min  0  0
[fd00::20]:/export/photos  /mnt/photos  nfs  vers=4.2,proto=tcp6,_netdev,nofail  0  0
