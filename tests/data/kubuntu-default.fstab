# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a device; this may
# be used with UUID= as a more robust way to name devices that works even if
# disks are added and removed. See fstab(5).
#
# <file system>             <mount point>  <type>  <options>  <dump>  <pass>
UUID=1A2B-3C4D                            /boot/efi      vfat    defaults   0 2
UUID=11111111-2222-4333-8444-555555555555 /              btrfs   subvol=/@,defaults,noatime,autodefrag 0 0
UUID=11111111-2222-4333-8444-555555555555 /home          btrfs   subvol=/@home,defaults,noatime,autodefrag 0 0
UUID=11111111-2222-4333-8444-555555555555 /swap          btrfs   subvol=/@swap,defaults 0 0
/swap/swapfile                            swap           swap    defaults   0 0
tmpfs                                     /tmp           tmpfs   defaults,noatime,mode=1777 0 0
